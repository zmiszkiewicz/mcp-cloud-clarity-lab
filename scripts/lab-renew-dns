#!/bin/bash
#
# Make the Part 3 test VM pick up the VPC's current DHCP options.
#
#   lab-renew-dns
#
# WHY THIS IS NEEDED AT ALL, and it is the least obvious thing in Part 3:
#
# A DHCP options set is applied to an instance when it takes or RENEWS a lease.
# Attaching one to the VPC does nothing to an instance that is already running
# — it keeps the resolver it booted with until its lease expires, hours later.
# So the participant points the VPC at the NIOS-X host, the console agrees, and
# the VM carries on asking AmazonProvidedDNS and answering NXDOMAIN.
#
# HOW IT RENEWS. It tries the cheap in-place methods first and falls back to
# rebooting the instance, which on Amazon Linux 2023 is what actually works.
# Forcing a real DHCP re-request means bouncing the interface, and every
# command that does so is issued over SSH ON THAT INTERFACE — it kills its own
# transport. A reboot sidesteps that, keeps the public address, and takes a
# minute or two.
#
# It checks the VPC's DHCP options FIRST, because "the options set is wrong"
# and "the VM has not picked it up" look identical from inside the VM and need
# opposite fixes. Rebooting to fix an unattached options set wastes two
# minutes and teaches nothing.
#
# Verifies by reading /etc/resolv.conf before and after, because none of these
# commands fails usefully: they exit 0 whether or not the resolver moved.
#
# Lives in the repo rather than being generated by a setup script, so it can be
# read, tested and fixed like any other file. Same shape as lab-dig.

set -uo pipefail
source /root/.bashrc 2>/dev/null || true

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: lab-renew-dns"
  echo "  Renews the test VM's DHCP lease so it picks up the VPC's DNS settings."
  exit 64
fi

SCRIPTS="${LAB_DIR:-/root/infoblox-lab/mcp-cloud-clarity-lab}/scripts"
cd "${SCRIPTS}" || {
  echo "lab-renew-dns: ${SCRIPTS} not found — is the lab repo cloned?" >&2
  exit 1
}

python3 - <<'PY'
import sys

import cloud_vpc

expected = cloud_vpc.dns_service_ip() or None

before, before_detail = cloud_vpc.test_vm_resolver()
if before is None:
    print(before_detail, file=sys.stderr)
    sys.exit(1)

# Both sides, before doing anything. When this fails, the cause is always one
# of these two disagreeing, and showing them costs nothing.
servers, servers_detail = cloud_vpc.vpc_dhcp_dns_servers()
print(f"  the VM is currently using   {before}")
print(f"  the VPC hands out           {', '.join(servers) or '(nothing — ' + servers_detail + ')'}")
if expected:
    print(f"  the DNS host is at          {expected}")

print("\nrenewing the lease...\n", flush=True)

ok, detail = cloud_vpc.renew_dhcp_lease(expect=expected)
print(detail)

if not ok:
    sys.exit(1)

print("\nNow try the query again:")
print("  lab-dig payments.svc.techcorp.internal")
PY
