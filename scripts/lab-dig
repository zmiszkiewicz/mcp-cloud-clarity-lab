#!/bin/bash
#
# Run a DNS query FROM INSIDE the lab VPC, on the Part 3 test VM.
#
#   lab-dig payments.svc.techcorp.internal
#   lab-dig payments.svc.techcorp.internal 10.40.1.53    # explicit resolver
#
# With no resolver argument the query goes to whatever the VM's own
# /etc/resolv.conf says, which is the stricter and more interesting test: it
# asks whether the VPC has actually been pointed at the new DNS service, not
# merely whether that service answers when aimed at directly.
#
# This is the SAME code path Part 3's check uses, deliberately — there is never
# an "it works for the check but not for me".
#
# The VM has no dig — Amazon Linux 2023 does not ship bind-utils and nothing is
# installed on the VM at boot. cloud_vpc copies a pure-stdlib DNS client over
# SSH and runs it with the preinstalled python3 instead.
#
# Lives in the repo rather than being generated by a setup script, so it can be
# read, tested and fixed like any other file.

set -uo pipefail
source /root/.bashrc 2>/dev/null || true

if [ $# -lt 1 ] || [ "${1}" = "-h" ] || [ "${1}" = "--help" ]; then
  echo "usage: lab-dig <fqdn> [resolver-ip]"
  exit 64
fi

SCRIPTS="${LAB_DIR:-/root/infoblox-lab/mcp-cloud-clarity-lab}/scripts"
cd "${SCRIPTS}" || {
  echo "lab-dig: ${SCRIPTS} not found — is the lab repo cloned?" >&2
  exit 1
}

FQDN="$1" RESOLVER="${2:-}" python3 - <<'PY'
import os
import sys

import cloud_vpc

fqdn = os.environ["FQDN"]
resolver = os.environ.get("RESOLVER") or cloud_vpc.dns_service_ip()

where = f"via {resolver}" if resolver else "via the VM's own resolver"
print(f"querying {fqdn} {where}, from inside the VPC...\n", flush=True)

# A short wait rather than none: a participant who reaches Part 3 unusually
# fast should get a pause, not a spurious failure.
answers, detail = cloud_vpc.resolve_from_test_vm(fqdn, resolver, boot_wait=60)
if answers:
    for answer in answers:
        print(answer)
    sys.exit(0)

print(detail, file=sys.stderr)
sys.exit(1)
PY
